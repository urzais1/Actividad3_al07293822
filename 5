# Pedimos el nombre del sistema
nombre_sistema = input("¿Cómo se llama tu sistema? ")

# Contador de operaciones: empieza en 0
operaciones = 0

# El menú se repite hasta que el usuario decida salir
while True:
    print()
    print("=====", nombre_sistema, "=====")
    print("1. Altas")
    print("2. Bajas")
    print("3. Cambios")
    print("4. Consultas")
    print("5. Imprimir")
    print("6. Salir")

    opcion = input("Elige una opción: ")

    if opcion == "1":
        print("➕ Aquí irán las ALTAS de productos deportivos")
        operaciones = operaciones + 1

    elif opcion == "2":
        print("🗑️ Aquí irán las BAJAS de productos deportivos")
        operaciones = operaciones + 1

    elif opcion == "3":
        print("✏️ Aquí irán los CAMBIOS de productos deportivos")
        operaciones = operaciones + 1

    elif opcion == "4":
        print("🔍 Aquí irán las CONSULTAS de productos deportivos")
        operaciones = operaciones + 1

    elif opcion == "5":
        print("🖨️ Aquí irá IMPRIMIR el inventario deportivo")
        operaciones = operaciones + 1

    elif opcion == "6":
        # Antes de salir, pedimos confirmación
        seguro = input("¿Seguro que quieres salir? (s/n): ")

        if seguro == "s":
            print("👋 Hiciste", operaciones, "operaciones. ¡Hasta luego!")
            break
        else:
            print("👍 Regresando al menú...")

    else:
        print("❌ Opción no válida, elige del 1 al 6")